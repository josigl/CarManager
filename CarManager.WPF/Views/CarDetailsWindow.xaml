<Window x:Class="CarManager.WPF.Views.CarDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarManager.WPF.Views"
        xmlns:uc="clr-namespace:CarManager.WPF.Controls"
        xmlns:vm="clr-namespace:CarManager.WPF.ViewModels.CarDetails"
        xmlns:vmd="clr-namespace:CarManager.WPF.ViewModels.Design"
        xmlns:vc="clr-namespace:CarManager.WPF.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vmd:CarDetailsDesignViewModel,IsDesignTimeCreatable=True}"
        Style="{StaticResource Window.Base}"
        WindowStartupLocation="CenterScreen"
        Title="Car Details"
        Height="1000" d:Height="1400" 
        Width="1400">

    <Grid>

        <!-- LOADING OVERLAY -->
        <Grid Background="{StaticResource Brush.Background.Surface}"
              d:Visibility="Collapsed"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" 
              Panel.ZIndex="1">

            <Path Style="{StaticResource LoadingSpinnerStyle}"
                  Data="{StaticResource Icon.LoadingSpinner}" 
                  Width="35"
                  Height="35"
                  Fill="{StaticResource Brush.Accent.Primary}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Stretch="Uniform"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True"
                  RenderTransformOrigin="0.5,0.5" />

        </Grid>

        <!-- MAIN CONTENT -->
        <Border Padding="40 30"
                Background="{StaticResource Brush.Background.Surface}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--        HEADER-SECTION        -->
                <!-- ============================ -->
                <StackPanel Grid.Row="0">

                    <!-- Header Bar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <!-- ID -->
                        <StackPanel Orientation="Horizontal"
                                Grid.Column="0">


                            <TextBlock Text="ID" 
                                   Margin="0 0 10 0"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                            <Border Padding="12 4"
                                BorderThickness="1"
                                BorderBrush="{StaticResource Brush.Border}"
                                CornerRadius="4"
                                Background="{StaticResource Brush.Background.Light}">


                                <TextBlock Text="{Binding Car.Id, StringFormat=\#{0}}" 
                                       FontWeight="SemiBold" 
                                       VerticalAlignment="Center"/>

                            </Border>

                        </StackPanel>

                        <!-- Status -->
                        <Border Grid.Column="2"
                            VerticalAlignment="Center"
                            Background="{Binding Car.Status, Converter={StaticResource CarStatusToBrushConverter}, ConverterParameter=Background, Mode=OneWay}"
                            Padding="10 5"
                            CornerRadius="4">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="6"
                                     Height="6"
                                     Margin="0 0 6 0"
                                     Fill="{Binding Car.Status, Converter={StaticResource CarStatusToBrushConverter}, Mode=OneWay}"
                                     VerticalAlignment="Center"/>


                                <TextBlock Text="{Binding Car.Status, Converter={StaticResource EnumToDisplayNameConverter}, Mode=OneWay}"
                                       Foreground="{Binding Car.Status, Converter={StaticResource CarStatusToBrushConverter}, Mode=OneWay}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- Car description / title -->
                    <TextBlock 
                    Margin="0 15 0 30"
                    FontWeight="Bold"
                    FontSize="35">

                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1} {2}">
                                <Binding Path="Car.Make" />
                                <Binding Path="Car.Model" />
                                <Binding Path="Car.Variant" />
                            </MultiBinding>
                        </TextBlock.Text>

                    </TextBlock>

                    <!-- Car Summary Items -->
                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <!-- Mileage -->
                        <uc:CarSummaryItem
                        Grid.Column="0"
                        Grid.Row="0"
                        Label="Mileage"
                        Value="{Binding Car.Mileage, StringFormat={}{0:N0} km}"
                        Icon="{StaticResource Icon.Road}" />

                        <!-- Power -->
                        <uc:CarSummaryItem
                        Grid.Column="1"
                        Grid.Row="0"
                        Label="Power"
                        Icon="{StaticResource Icon.Power}" 
                        IconSize="36">

                            <uc:CarSummaryItem.Value>
                                <MultiBinding StringFormat="{}{0} kW ({1} hp)">
                                    <Binding Path="Car.TechnicalData.PowerKw" />
                                    <Binding Path="TechnicalTab.PowerHp" />
                                </MultiBinding>
                            </uc:CarSummaryItem.Value>

                        </uc:CarSummaryItem>



                        <!-- Fuel Type -->
                        <uc:CarSummaryItem
                        Grid.Column="2"
                        Grid.Row="0"
                        Label="Fuel Type"
                        Value="{Binding Car.TechnicalData.FuelType}"
                        Icon="{StaticResource Icon.Gas}" 
                        IconSize="30"/>

                        <!-- Transmission -->
                        <uc:CarSummaryItem
                        Grid.Column="0"
                        Grid.Row="2"
                        Label="Transmission"
                        Value="{Binding Car.TechnicalData.TransmissionType, Converter={StaticResource EnumToDisplayNameConverter}}"
                        Icon="{StaticResource Icon.Gearbox}" 
                        IconSize="34"/>

                        <!-- First Registration -->
                        <uc:CarSummaryItem
                        Grid.Column="1"
                        Grid.Row="2"
                        Label="First Registration"
                        Value="{Binding Car.FirstRegistration, StringFormat={}{0:MM-yyyy}}"
                        Icon="{StaticResource Icon.Calender}" 
                        IconSize="32"/>

                        <!-- Current Value -->
                        <uc:CarSummaryItem
                        Grid.Column="2"
                        Grid.Row="2"
                        Label="Current Value"
                        Value="{Binding Car.CommercialData.CurrentValue, StringFormat={}{0:N0} EUR}"
                        Icon="{StaticResource Icon.PriceTag}" 
                        IconSize="34"/>

                    </Grid>

                </StackPanel>

                <!--        TABS-SECTION        -->
                <!-- ============================ -->
                <TabControl 
                    Grid.Row="1"
                    Margin="0 50 0 0"
                    BorderThickness="0"
                    Padding="0 30 0 0">

                    <!-- General -->
                    <uc:CarTabItem Header="General" 
                               Icon="{StaticResource Icon.Tab.General}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <!-- Car Information -->
                                <TextBlock  Text="Car Information"
                                        Style="{StaticResource CarTabGroupHeader}" />

                                <StackPanel Style="{StaticResource CarTabGroupItems}">
                                    <uc:CarDetailRow Label="Make" Value="{Binding Car.Make}" />
                                    <uc:CarDetailRow Label="Model" Value="{Binding Car.Model}" />
                                    <uc:CarDetailRow Label="Variant" Value="{Binding Car.Variant}" />
                                    <uc:CarDetailRow Label="Body Type" Value="{Binding Car.BodyType}" />
                                    <uc:CarDetailRow Label="Model Year" Value="{Binding Car.ModelYear}" />
                                    <uc:CarDetailRow Label="First Registration" Value="{Binding Car.FirstRegistration, StringFormat={}{0:yyyy-MM-dd}}" />
                                </StackPanel>


                                <!-- Identication -->
                                <TextBlock  Text="Identication"
                                        Style="{StaticResource CarTabGroupHeader}" />

                                <StackPanel Style="{StaticResource CarTabGroupItems}">
                                    <uc:CarDetailRow Label="ID" Value="{Binding Car.Id}" />
                                    <uc:CarDetailRow Label="VIN" Value="{Binding Car.Vin}" />
                                    <uc:CarDetailRow Label="License Plate" Value="{Binding Car.LicensePlate}" />
                                </StackPanel>


                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <!-- Classification -->
                                <TextBlock  Text="Classification"
                                        Style="{StaticResource CarTabGroupHeader}" />

                                <StackPanel Style="{StaticResource CarTabGroupItems}">
                                    <uc:CarDetailRow Label="Condition" Value="{Binding Car.Condition}" />
                                    <uc:CarDetailRow Label="Status" Value="{Binding Car.Status, Converter={StaticResource EnumToDisplayNameConverter}, Mode=OneWay}" />
                                    <uc:CarDetailRow Label="Previous Owners" Value="{Binding Car.PreviousOwners}" />
                                    <uc:CarDetailRow Label="Location" Value="{Binding Car.Location}" />
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Margin="0">
                                    <Button Style="{StaticResource Button.Base}" Content="Generate PDF Summary" />
                                </StackPanel>

                            </StackPanel>

                        </Grid>


                    </uc:CarTabItem>

                    <!-- Technical -->
                    <uc:CarTabItem  
                        Header="Technical" 
                        Icon="{StaticResource Icon.Tab.Technical}"
                        DataContext="{Binding TechnicalTab}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Data Table -->
                            <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Auto">

                                <StackPanel>

                                    <!-- Technical Data -->
                                    <TextBlock  Text="Technical Data"
                                                Style="{StaticResource CarTabGroupHeader}" />

                                    <StackPanel Style="{StaticResource CarTabGroupItems}">
                                        <uc:CarDetailRow Label="Power">
                                            <uc:CarDetailRow.Value>
                                                <MultiBinding StringFormat="{}{0} kW ({1} hp)">
                                                    <Binding Path="Data.PowerKw" />
                                                    <Binding Path="PowerHp" />
                                                </MultiBinding>
                                            </uc:CarDetailRow.Value>

                                        </uc:CarDetailRow>
                                        <uc:CarDetailRow Label="Torque" Value="{Binding TechnicalData.TorqueNm, StringFormat={}{0:N0} Nm}" />
                                        <uc:CarDetailRow Label="Acceleration 0–100 km/h" Value="{Binding TechnicalData.Acceleration, StringFormat={}{0:N1} s}" />
                                        <uc:CarDetailRow Label="Top Speed" Value="{Binding TechnicalData.TopSpeedKmh, StringFormat={}{0:N0} km/h}" />
                                        <uc:CarDetailRow Label="Transmission" Value="{Binding TechnicalData.TransmissionType,Converter={StaticResource EnumToDisplayNameConverter}}" />
                                        <uc:CarDetailRow Label="Drive Type" Value="{Binding TechnicalData.DriveType}" />
                                        <uc:CarDetailRow Label="Energy Source" Value="{Binding TechnicalData.FuelType}" />
                                        <uc:CarDetailRow Label="Curb Weight" Value="{Binding TechnicalData.CurbWeightKg, StringFormat={}{0:N0} kg}" />
                                        <uc:CarDetailRow Label="Trunk Capacity" Value="{Binding TechnicalData.TrunkCapacityLiters , StringFormat={}{0:N0} l}" />
                                        <uc:CarDetailRow Label="Exterior Color" Value="{Binding TechnicalData.ExteriorColor}" />
                                        <uc:CarDetailRow Label="Interior Color" Value="{Binding TechnicalData.InteriorColor}" />
                                    </StackPanel>

                                    <!-- Engine &  Powertrain -->
                                    <StackPanel Style="{StaticResource CarTabGroupItems}">

                                        <TextBlock  Text="Engine &amp; Powertrain"
                                            Style="{StaticResource CarTabGroupHeader}" />

                                        <uc:CarDetailRow Label="Powertrain Type" Value="{Binding TechnicalData.PowerTrain}" />

                                        <!-- Combustion -->
                                        <StackPanel Visibility="{Binding IsCombustion, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <uc:CarDetailRow Label="Engine Type"            Value="{Binding TechnicalData.EngineType}" />
                                            <uc:CarDetailRow Label="Displacement"           Value="{Binding TechnicalData.DisplacementCc, StringFormat={}{0:N0} cm³}" />
                                            <uc:CarDetailRow Label="Cylinders"              Value="{Binding TechnicalData.Cylinders}" />
                                            <uc:CarDetailRow Label="Fuel Tank Capacity"     Value="{Binding TechnicalData.FuelTankCapacityLiters, StringFormat={}{0:N0} l}" />
                                            <uc:CarDetailRow Label="Fuel Consumption"       Value="{Binding TechnicalData.FuelConsumption, StringFormat={}{0:N1} l/100 km}" />
                                            <uc:CarDetailRow Label="CO₂ Emissions"          Value="{Binding TechnicalData.Co2Emissions, StringFormat={}{0:N0} g/km}" />
                                            <uc:CarDetailRow Label="Emission Standard"      Value="{Binding TechnicalData.EmissionStandard}" />
                                        </StackPanel>

                                        <!-- Electric -->
                                        <StackPanel Visibility="{Binding IsElectric, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <uc:CarDetailRow Label="Motor Type"             Value="{Binding TechnicalData.MotorType}" />
                                            <uc:CarDetailRow Label="Battery Capacity"       Value="{Binding TechnicalData.BatteryCapacityKwh, StringFormat={}{0:N0} kWh}" />
                                            <uc:CarDetailRow Label="Usable Capacity"        Value="{Binding TechnicalData.UsableBatteryCapacityKwh, StringFormat={}{0:N0} kWh}" />
                                            <uc:CarDetailRow Label="Range (WLTP)"           Value="{Binding TechnicalData.ElectricRangeKm, StringFormat={}{0:N0} km}" />
                                            <uc:CarDetailRow Label="Energy Consumption"     Value="{Binding TechnicalData.EnergyConsumption, StringFormat={}{0:N1} kWh / 100 km}" />
                                            <uc:CarDetailRow Label="Charging Power (AC)"    Value="{Binding TechnicalData.ChargingPowerAcKw, StringFormat={}{0:N0} kW}" />
                                            <uc:CarDetailRow Label="Charging Power (DC)"    Value="{Binding TechnicalData.ChargingPowerDcKw, StringFormat={}{0:N0} kW}" />
                                        </StackPanel>

                                        <!-- Hybrid -->
                                        <StackPanel Visibility="{Binding IsHybrid, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <uc:CarDetailRow Label="Engine Type"            Value="{Binding TechnicalData.EngineType}" />
                                            <uc:CarDetailRow Label="Displacement"           Value="{Binding TechnicalData.DisplacementCc, StringFormat={}{0:N0} cm³}" />
                                            <uc:CarDetailRow Label="Battery Type"           Value="{Binding TechnicalData.BatteryType}" />
                                            <uc:CarDetailRow Label="Battery Capacity"       Value="{Binding TechnicalData.BatteryCapacityKwh, StringFormat={}{0:N0} kWh}" />
                                            <uc:CarDetailRow Label="Fuel Consumption"       Value="{Binding TechnicalData.FuelConsumption, StringFormat={}{0:N1} l/100 km}" />
                                            <uc:CarDetailRow Label="CO₂ Emissions"          Value="{Binding TechnicalData.Co2Emissions, StringFormat={}{0:N0} g/km}" />
                                            <uc:CarDetailRow Label="Emission Standard"      Value="{Binding TechnicalData.EmissionStandard}" />
                                        </StackPanel>

                                        <!-- Plug-in-Hybrid -->
                                        <StackPanel Visibility="{Binding IsPlugInHybrid, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <uc:CarDetailRow Label="Engine Type"            Value="{Binding TechnicalData.EngineType}" />
                                            <uc:CarDetailRow Label="Displacement"           Value="{Binding TechnicalData.DisplacementCc, StringFormat={}{0:N0} cm³}" />
                                            <uc:CarDetailRow Label="Battery Capacity"       Value="{Binding TechnicalData.BatteryCapacityKwh, StringFormat={}{0:N0} kWh}" />
                                            <uc:CarDetailRow Label="Electric Range"         Value="{Binding TechnicalData.ElectricRangeKm, StringFormat={}{0:N0} km}" />
                                            <uc:CarDetailRow Label="Fuel Consumption"       Value="{Binding TechnicalData.FuelConsumption, StringFormat={}{0:N1} l/100 km}" />
                                            <uc:CarDetailRow Label="Enerty Consumption"     Value="{Binding TechnicalData.EnergyConsumption, StringFormat={}{0:N1} kWh / 100 km}" />
                                            <uc:CarDetailRow Label="CO₂ Emissions"          Value="{Binding TechnicalData.Co2Emissions, StringFormat={}{0:N0} g/km}" />
                                            <uc:CarDetailRow Label="Emission Standard"      Value="{Binding TechnicalData.EmissionStandard}" />
                                        </StackPanel>

                                    </StackPanel>

                                </StackPanel>

                            </ScrollViewer>

                            <!-- Metric Items -->
                            <Grid Grid.Column="2">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>


                                <!-- Acceleration -->
                                <uc:CarMetricItem Grid.Row="0" Label="Acceleration" Value="{Binding TechnicalData.Acceleration, StringFormat={}{0:N1} s}" />

                                <!-- Top Speed -->
                                <uc:CarMetricItem Grid.Row="1" Label="Top Speed" Value="{Binding TechnicalData.TopSpeedKmh, StringFormat={}{0:N0} km/h}" />

                                <!-- Consumption -->
                                <uc:CarMetricItem Grid.Row="2"  Label="Fuel Consumption" Value="{Binding TechnicalData.FuelConsumption, StringFormat={}{0:N1} l/100 km}" />

                            </Grid>

                        </Grid>

                    </uc:CarTabItem>

                    <!-- Commercial -->
                    <uc:CarTabItem  Header="Commercial" 
                                Icon="{StaticResource Icon.Tab.Commercial}"
                                DataContext="{Binding CommercialTab}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Card Grid -->
                                <Grid Grid.Row="0"
                                  HorizontalAlignment="Left">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Current Value -->
                                    <uc:CarCommercialMetricItem
                                        Style="{StaticResource CarCommercialMetricCard.Highlighted}"
                                        Grid.Column="0"
                                        Grid.Row="0"
                                        Label="Current Value"
                                        Value="{Binding CommercialData.CurrentValue, StringFormat={}{0:N0} EUR}" 
                                        InfoText="351.904,68 USD (06.08.2026)"
                                        InfoIcon="{StaticResource Icon.ExchangeRate}"/>

                                    <!-- Purchase Value -->
                                    <uc:CarCommercialMetricItem 
                                        Grid.Column="2"
                                        Grid.Row="0"
                                        Label="Purchase Price"
                                        Value="{Binding CommercialData.PurchasePrice, StringFormat={}{0:N0} EUR}"
                                        InfoText="{Binding PurchasePriceInfo}"
                                        InfoIcon="{StaticResource Icon.PurchaseDate}"/>

                                    <!-- Value Change -->
                                    <uc:CarCommercialMetricItem 
                                        Grid.Column="0"
                                        Grid.Row="2"
                                        Label="Value Change"
                                        InfoText="{Binding ValueChangePercentageAbsolute, StringFormat={}{0:N1}%}"
                                        InfoIcon="{Binding ValueChangePercentage, Converter={StaticResource ValueChangeIconConverter}}"
                                        InfoForeground="{Binding ValueChangePercentage, Converter={StaticResource ValueChangeBrushConverter}}">

                                        <uc:CarCommercialMetricItem.Value>
                                            <Binding
                                                Path="ValueChange"
                                                StringFormat="{}{0:+#,##0.00;-#,##0.00;0.00} EUR" />
                                        </uc:CarCommercialMetricItem.Value>

                                    </uc:CarCommercialMetricItem>

                                    <!-- Annual Running Costs -->
                                    <uc:CarCommercialMetricItem 
                                        Grid.Column="2"
                                        Grid.Row="2"
                                        Label="Annual Running Costs"
                                        Value="{Binding AnnualRunningCosts, StringFormat={}{0:N0} EUR}"
                                        InfoText="{Binding AnnualRunningCostsPerMonth, StringFormat={}{0:N2} EUR}"
                                        InfoIcon="{StaticResource Icon.CarTco}"/>

                                </Grid>

                                <ScrollViewer 
                                    Grid.Row="2"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Auto">

                                    <StackPanel>
                                        <!-- Purachse Information -->
                                        <TextBlock  Text="Purachse Information"
                                                Style="{StaticResource CarTabGroupHeader}" />

                                        <StackPanel Style="{StaticResource CarTabGroupItems}">
                                            <uc:CarDetailRow Label="Dealer" Value="{Binding CommercialData.Dealer}" />
                                            <uc:CarDetailRow Label="Invoice No." Value="{Binding CommercialData.InvoiceNo}" />
                                            <uc:CarDetailRow Label="Purachse Date" Value="{Binding CommercialData.PurchaseDate, StringFormat={}{0:yyyy-MM-dd}}" />
                                            <uc:CarDetailRow Label="Warranty Until" Value="{Binding CommercialData.WarrantyUntil, StringFormat={}{0:yyyy-MM-dd}}" />
                                        </StackPanel>

                                        <!-- Annual Running Costs -->
                                        <TextBlock  Text="Annual Running Costs"
                                                Style="{StaticResource CarTabGroupHeader}" />

                                        <StackPanel Style="{StaticResource CarTabGroupItems}">
                                            <uc:CarDetailRow Label="Insurance" Value="{Binding CommercialData.AnnualInsuranceCost, StringFormat={}{0:N0} EUR}" />
                                            <uc:CarDetailRow Label="Road Tax" Value="{Binding CommercialData.AnnualRoadTax, StringFormat={}{0:N0} EUR}" />
                                            <uc:CarDetailRow Label="Fuel Costs" Value="{Binding CommercialData.AnnualFuelCost, StringFormat={}{0:N0} EUR}" />
                                            <uc:CarDetailRow Label="Maintenance Costs" Value="{Binding CommercialData.AnnualMaintenanceCost, StringFormat={}{0:N0} EUR}" />
                                        </StackPanel>

                                    </StackPanel>

                                </ScrollViewer>

                            </Grid>


                            <!-- Timeline -->
                            <ScrollViewer Grid.Column="2"
                                          VerticalScrollBarVisibility="Auto">

                                <Grid 
                                    HorizontalAlignment="Right"
                                    Margin="100 0">
                                    
                                    <ItemsControl ItemsSource="{Binding TimelineItems}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <uc:CarTimeLineItem 
                                                Label="{Binding Title}"
                                                Value="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"
                                                InfoText="{Binding Description}"
                                                CheckIcon="{Binding IsCompleted, Converter={StaticResource TimelineIconConverter}}" />

                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </Grid>
                            </ScrollViewer>
                            
                        </Grid>

                    </uc:CarTabItem>

                </TabControl>

            </Grid>
        </Border>

    </Grid>
</Window>
