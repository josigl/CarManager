<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uc="clr-namespace:CarManager.WPF.Controls">
    
    <!-- Car Tab Item -->
    <Style TargetType="{x:Type uc:CarTabItem}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Main}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type uc:CarTabItem}">

                    <Border x:Name="border"
                            Background="Transparent"
                            Cursor="Hand"
                            Padding="10"
                            MinWidth="80"
                            BorderThickness="0 0 0 3">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                            <Path x:Name="icon"
                                  Width="{TemplateBinding IconSize}"
                                  Height="{TemplateBinding IconSize}"
                                  Fill="{StaticResource Brush.Text.Secondary}"
                                  Data="{TemplateBinding Icon}" 
                                  Stretch="Uniform"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                  VerticalAlignment="Center"/>

                            <TextBlock x:Name="label"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Margin="10 0" 
                                       Text="{TemplateBinding Header}"
                                       VerticalAlignment="Center"
                                       FontWeight="Medium"/>

                        </StackPanel>
                        
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Brush.Accent.Primary}" />
                            <Setter TargetName="icon" Property="Fill" Value="{StaticResource Brush.Accent.Primary}" />
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Brush.Accent.Primary}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>

                            <Setter TargetName="icon" Property="Fill" Value="{StaticResource Brush.Text.Main}" />
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Brush.Text.Main}" />

                        </MultiTrigger>
                        
                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Car Tab Group Header -->
    <Style TargetType="{x:Type TextBlock}" x:Key="CarTabGroupHeader">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="0 0 0 10" />
    </Style>

    <!-- Car Tab Group Items -->
    <Style TargetType="{x:Type StackPanel}" x:Key="CarTabGroupItems">
        <Setter Property="Margin" Value="0 0 0 30" />
    </Style>

    <!-- Car Tab Commercial Card -->
    <Style TargetType="{x:Type uc:CarCommercialMetricItem}" x:Key="CarCommercialMetricCard.Highlighted">
        <Setter Property="CardBackground" Value="{StaticResource Brush.Accent.Primary}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Inverse}" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="InfoForeground" Value="{StaticResource Brush.Text.CommercialCard.Highlighted}" />
    </Style>
    
</ResourceDictionary>