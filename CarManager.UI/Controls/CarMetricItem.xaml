<UserControl x:Class="CarManager.UI.Controls.CarMetricItem"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarManager.UI.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="200"
             RenderOptions.BitmapScalingMode="HighQuality"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             d:FontFamily="{StaticResource Roboto}">
    
    <Grid VerticalAlignment="Center"
          HorizontalAlignment="Center">
        
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            
            <!-- Value -->
            <TextBlock 
                HorizontalAlignment="Center"
                Text="{Binding Value, ElementName=root, FallbackValue='296 km/h'}" 
                FontSize="40"
                FontWeight="Bold"/>

            <!-- Separator -->
            <Border 
                BorderBrush="{StaticResource Brush.Accent.Primary}"
                BorderThickness="3" 
                Width="30"
                CornerRadius="1"
                Margin="0 10 0 3"
                HorizontalAlignment="Center"/> 

            <!-- Label -->
            <TextBlock 
                Text="{Binding Label, ElementName=root, FallbackValue='Top Speed'}"
                Foreground="{StaticResource Brush.Text.Secondary}"
                FontSize="20"
                FontWeight="Medium"
                HorizontalAlignment="Center"/>

        </StackPanel>
        
    </Grid>
    
</UserControl>
